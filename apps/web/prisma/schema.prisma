generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int          @id @default(autoincrement())
  email          String       @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  avatar         String?
  role           UserRole     @default(MEMBER)
  status         UserStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  attendance     Attendance[] @relation("UserAttendance")
  bookings       Booking[]    @relation("UserBookings")
  coachedMembers Member[]     @relation("MemberCoach")
  member         Member?
  payments       Payment[]    @relation("UserPayments")
}

model Program {
  id            Int          @id @default(autoincrement())
  name          String
  slug          String       @unique
  description   String?
  durationWeeks Int?
  price         Decimal?     @db.Decimal(10, 2)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  attendance    Attendance[]
  bookings      Booking[]
  members       Member[]
}

model Member {
  id          Int              @id @default(autoincrement())
  userId      Int?             @unique
  coachId     Int?
  programId   Int?
  fullName    String
  email       String?
  phone       String?
  gender      String?
  dateOfBirth DateTime?
  membership  MembershipStatus @default(PENDING)
  startDate   DateTime?
  endDate     DateTime?
  visits      Int              @default(0)
  avatar      String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  attendance  Attendance[]
  bookings    Booking[]
  coach       User?            @relation("MemberCoach", fields: [coachId], references: [id])
  program     Program?         @relation(fields: [programId], references: [id])
  user        User?            @relation(fields: [userId], references: [id])
  orders      Order[]
  payments    Payment[]

  @@index([membership])
  @@index([coachId])
  @@index([programId])
}

model Attendance {
  id        Int              @id @default(autoincrement())
  memberId  Int
  userId    Int?
  programId Int?
  checkIn   DateTime?
  checkOut  DateTime?
  date      DateTime         @default(now())
  status    AttendanceStatus @default(CHECKED_IN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  program   Program?         @relation(fields: [programId], references: [id])
  user      User?            @relation("UserAttendance", fields: [userId], references: [id])

  @@index([memberId])
  @@index([date])
  @@index([status])
}

model Booking {
  id        Int           @id @default(autoincrement())
  memberId  Int
  coachId   Int?
  programId Int?
  date      DateTime
  time      String
  status    BookingStatus @default(PENDING)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  coach     User?         @relation("UserBookings", fields: [coachId], references: [id])
  member    Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  program   Program?      @relation(fields: [programId], references: [id])

  @@index([memberId])
  @@index([coachId])
  @@index([programId])
  @@index([date])
  @@index([status])
}

model Payment {
  id          Int           @id @default(autoincrement())
  memberId    Int?
  userId      Int?
  description String
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  date        DateTime      @default(now())
  reference   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  member      Member?       @relation(fields: [memberId], references: [id])
  user        User?         @relation("UserPayments", fields: [userId], references: [id])

  @@index([memberId])
  @@index([status])
  @@index([date])
}

model Product {
  id               Int                    @id @default(autoincrement())
  sku              String                 @unique
  slug             String                 @unique
  name             String
  shortDescription String?
  description      String?
  category         String?
  brand            String?
  badge            String?
  price            Decimal                @db.Decimal(10, 2)
  oldPrice         Decimal?               @db.Decimal(10, 2)
  discount         Int?
  stock            Int                    @default(0)
  status           ProductStatus          @default(IN_STOCK)
  weight           String?
  size             String?
  color            String?
  featured         Boolean                @default(false)
  bestseller       Boolean                @default(false)
  isNew            Boolean                @default(false)
  rating           Decimal?               @db.Decimal(3, 2)
  reviews          Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  orderItems       OrderItem[]
  features         ProductFeature[]
  images           ProductImage[]
  specifications   ProductSpecification[]
  tags             ProductTag[]

  @@index([category])
  @@index([status])
  @@index([featured])
  @@index([bestseller])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  alt       String?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductFeature {
  id        Int     @id @default(autoincrement())
  productId Int
  value     String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductTag {
  id        Int     @id @default(autoincrement())
  productId Int
  value     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSpecification {
  id        Int     @id @default(autoincrement())
  productId Int
  name      String
  value     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id            Int         @id @default(autoincrement())
  orderNumber   String      @unique
  memberId      Int?
  customerName  String
  customerEmail String?
  customerPhone String?
  amount        Decimal     @db.Decimal(10, 2)
  status        OrderStatus @default(PENDING)
  date          DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  member        Member?     @relation(fields: [memberId], references: [id])
  items         OrderItem[]

  @@index([memberId])
  @@index([status])
  @@index([date])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int
  productName String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model AcademyItem {
  id               Int             @id @default(autoincrement())
  type             AcademyItemType
  title            String
  slug             String          @unique
  shortDescription String?
  description      String?
  href             String?
  status           AcademyStatus   @default(DRAFT)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  topics           AcademyTopic[]

  @@index([type])
  @@index([status])
}

model AcademyTopic {
  id            Int         @id @default(autoincrement())
  academyItemId Int
  value         String
  position      Int         @default(0)
  academyItem   AcademyItem @relation(fields: [academyItemId], references: [id], onDelete: Cascade)

  @@index([academyItemId])
}

enum UserRole {
  ADMIN
  COACH
  STAFF
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  PENDING
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  PENDING
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  CHECKED_IN
  CHECKED_OUT
  ABSENT
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
}

enum ProductStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum AcademyItemType {
  PROGRAM
  COURSE
  CERTIFICATION
  WORKSHOP
}

enum AcademyStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}
